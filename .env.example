# Required: create with @BotFather and keep private
TELEGRAM_BOT_TOKEN=

# Optional: comma-separated Telegram user IDs allowed to configure/scan
ADMIN_USER_IDS=

# SQLite database path
DATABASE_PATH=bot.sqlite3

# Feed polling interval; minimum enforced at 60 seconds
POLL_INTERVAL_SECONDS=900
HTTP_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO
